# Vite's hashed asset filenames change whenever content changes, so they can be
# cached forever. HTML stays on the revalidating default so a deploy is picked
# up immediately.
#
# NOTE: _headers never applies to Worker-generated responses. The form endpoint
# sets its own Cache-Control: no-store.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
