# Public, build-time. Copy to .env — every value below works with no account.

# Canonical URL, og:url, absolute OG image, JSON-LD url (issue #30).
# Production is https://execil.net, set as the VITE_SITE_URL GitHub variable.
VITE_SITE_URL=http://localhost:3000

# Turnstile invisible widget. This is Cloudflare's always-passes TEST sitekey;
# it works on localhost and any dev domain. Real key at provisioning (issue #28).
VITE_TURNSTILE_SITEKEY=1x00000000000000000000BB

# Address behind the form's "Open Email" failure fallback (issue #27)
VITE_CONTACT_EMAIL=contact@execil.net

# PostHog browser analytics. Set these to the project's public token and host.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

