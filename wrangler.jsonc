{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "execil",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  // Prerender writes each page as <path>/index.html, and Cloudflare's default
  // html_handling would answer /privacy with a 307 to /privacy/. Every link and
  // canonical on the site is the unslashed form, so drop the slash instead.
  "assets": {
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,

  // Plaintext config, and deliberately in git rather than the dashboard: these
  // are not secrets, and a reviewer should see where submissions go.
  //
  // ASSESSMENT_TO is where submissions land: the Hostinger mailbox behind the
  // apex MX. Resend delivers to it like any other recipient -- no verification
  // step, unlike the Cloudflare binding this replaced.
  "vars": {
    "ASSESSMENT_TO": "contact@execil.net",
    // Bare domain. The route composes assessment@forms.<SENDER_DOMAIN>, so this
    // is the apex -- the subdomain is added by the route, not stored here.
    // forms.execil.net is the domain verified in Resend.
    "SENDER_DOMAIN": "execil.net",
  },

  // No send_email binding. Cloudflare Email Service needs the APEX onboarded
  // to Email Routing, and its confirmation screen replaces the Hostinger MX
  // and SPF records that carry the business mailbox. Delivery goes through
  // Resend instead, sending from a subdomain so nothing at the apex moves.
  //
  // TURNSTILE_SECRET and RESEND_API_KEY are NOT here. They are secrets, this
  // file is committed, and Cloudflare's own guidance is to keep sensitive
  // values out of `vars`. Set both under Settings > Variables & Secrets
  // (locally: .dev.vars).
}
